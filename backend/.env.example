# Copy to .env and fill values (never commit .env)

PORT=4000
NODE_ENV=development

# Firebase Admin — download JSON from Firebase Console → Project settings → Service accounts
# Option A: path to service account file (relative to backend folder)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: inline JSON (single line, escapes quotes) — omit GOOGLE_APPLICATION_CREDENTIALS if using this
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Realtime Database URL (Firebase Console → Realtime Database → copy URL)
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Allowed web origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# Email (SMTP) — required for OTP registration & password reset on mobile
# Works with Gmail App Password, SendGrid SMTP, Mailgun, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="MedSwift" <your-email@gmail.com>

# When true (or NODE_ENV=development without SMTP), OTP codes are logged to the API console
EMAIL_MOCK=true
